# ============================================================
# Agentic RAG 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

# --- LLM 配置 ---
AGENTIC_RAG_LLM__PROVIDER=ollama
AGENTIC_RAG_LLM__MODEL=qwen2.5:7b
AGENTIC_RAG_LLM__BASE_URL=http://localhost:11434
AGENTIC_RAG_LLM__TEMPERATURE=0.0
AGENTIC_RAG_LLM__MAX_TOKENS=4096
AGENTIC_RAG_LLM__CONTEXT_WINDOW=8192
AGENTIC_RAG_LLM__REQUEST_TIMEOUT=300.0

# --- Embedding 配置 ---
AGENTIC_RAG_EMBEDDING__PROVIDER=ollama
AGENTIC_RAG_EMBEDDING__MODEL_NAME=nomic-embed-text
AGENTIC_RAG_EMBEDDING__BASE_URL=http://localhost:11434
AGENTIC_RAG_EMBEDDING__BATCH_SIZE=32

# --- Qdrant 配置 ---
AGENTIC_RAG_QDRANT__URL=http://localhost:6333
AGENTIC_RAG_QDRANT__COLLECTION_NAME=agentic_rag_knowledge
AGENTIC_RAG_QDRANT__VECTOR_SIZE=768

# --- 检索配置 ---
AGENTIC_RAG_RETRIEVAL__SIMILARITY_TOP_K=10
AGENTIC_RAG_RETRIEVAL__RERANKER_TOP_N=5
AGENTIC_RAG_RETRIEVAL__SIMILARITY_CUTOFF=0.2
AGENTIC_RAG_RETRIEVAL__ENABLE_QUERY_REWRITE=true
AGENTIC_RAG_RETRIEVAL__ENABLE_DOCUMENT_GRADING=true
AGENTIC_RAG_RETRIEVAL__ENABLE_REFLECTION=true

# --- Memory 配置 ---
AGENTIC_RAG_MEMORY__CHECKPOINT_DB_PATH=./checkpoints.db

# ============================================================
# 存储扩展层（Redis + MySQL）
#
# 两层的 enabled 都默认为 false —— 不配这一节时，系统行为与引入本扩展之前
# 完全一致（SQLite checkpoint、无缓存、无归档）。想用就照下面打开。
#
# 连不上时全链路静默降级：Redis 挂 → 无缓存/无多轮摘要；MySQL 挂 → 无归档。
# 主流程永远不会因为存储层失败而失败。CI / 生产想让它报错就设 strict=true。
# ============================================================

# --- Redis：Session / 短期摘要 / 热点问答缓存 / LangGraph checkpoint ---
AGENTIC_RAG_REDIS__ENABLED=false
AGENTIC_RAG_REDIS__URL=redis://localhost:6379/0

# --- MySQL：用户 / 会话 / 问答记录 / 文档元数据 / 执行追踪 ---
AGENTIC_RAG_MYSQL__ENABLED=false
AGENTIC_RAG_MYSQL__URL=mysql+pymysql://agentic:agentic@localhost:3306/agentic_rag?charset=utf8mb4

# --- 可选：调优（默认值即可用，列出来是为了好改）---
# AGENTIC_RAG_REDIS__SESSION_TTL=1800         # 会话滑动过期（秒）
# AGENTIC_RAG_REDIS__WINDOW_SIZE=10           # 保留最近 N 条消息
# AGENTIC_RAG_REDIS__SUMMARY_TRIGGER=12       # 消息数达到此值触发滚动摘要
# AGENTIC_RAG_REDIS__SUMMARY_KEEP_RECENT=6    # 摘要后保留最近 N 条不压缩
# AGENTIC_RAG_REDIS__CACHE_TTL=3600
# AGENTIC_RAG_REDIS__CACHE_MIN_HITS=2         # 观察到 N 次才写缓存（热点门槛）；设 1 = 立即缓存
# AGENTIC_RAG_REDIS__STRICT=false             # true=连不上直接抛错

# checkpoint 后端：redis=官方 RedisSaver（需 RedisJSON+RediSearch，即 redis:8）
#                 sqlite=沿用 SqliteSaver   none=不持久化（无多轮记忆）
# 配 redis 但 Redis 不可用时会自动退回 sqlite。
# AGENTIC_RAG_REDIS__CHECKPOINT_BACKEND=redis
# AGENTIC_RAG_REDIS__CHECKPOINT_TTL=1440      # 分钟

# AGENTIC_RAG_MYSQL__AUTO_CREATE=true         # 启动时 create_all；上 Alembic 后置 false
# AGENTIC_RAG_MYSQL__STRICT=false
